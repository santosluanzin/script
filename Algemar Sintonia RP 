-- ================== FUNÇÕES DE EXECUÇÃO ==================
-- Função base para puxar a algema (usada tanto no botão manual quanto no automático)
local function executarAlgemar()
    pcall(function()
        local currentGui = LocalPlayer:WaitForChild("PlayerGui")
        local executed = false
        for _, gui in ipairs(currentGui:GetChildren()) do
            if gui:IsA("ScreenGui") then
                local btn = gui:FindFirstChild("Algemar", true) or gui:FindFirstChild("Cuff", true)
                if btn and btn:IsA("GuiButton") then
                    if typeof(getconnections) == "function" then
                        for _, c in ipairs(getconnections(btn.MouseButton1Click)) do c:Fire() executed = true end
                        for _, c in ipairs(getconnections(btn.Activated)) do c:Fire() executed = true end
                    end
                    if not executed and firesignal then firesignal(btn.MouseButton1Click) executed = true end
                end
            end
        end
        if not executed then
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if hrp then
                for _, obj in ipairs(workspace:GetDescendants()) do
                    if obj:IsA("ProximityPrompt") and (obj.ActionText:lower():find("algemar") or obj.ObjectText:lower():find("algemar")) then
                        if (hrp.Position - obj.Parent.Position).Magnitude <= 15 then
                            fireproximityprompt(obj) executed = true
                        end
                    end
                end
            end
        end
    end)
end

local function executarDeitar()
    pcall(function()
        local currentGui = LocalPlayer:WaitForChild("PlayerGui")
        local executed = false
        for _, gui in ipairs(currentGui:GetChildren()) do
            if gui:IsA("ScreenGui") then
                local btn = gui:FindFirstChild("Deitar", true) or gui:FindFirstChild("Sleep", true) or gui:FindFirstChild("Deit", true)
                if btn and btn:IsA("GuiButton") then
                    if typeof(getconnections) == "function" then
                        for _, c in ipairs(getconnections(btn.MouseButton1Click)) do c:Fire() executed = true end
                        for _, c in ipairs(getconnections(btn.Activated)) do c:Fire() executed = true end
                    end
                    if not executed and firesignal then firesignal(btn.MouseButton1Click) executed = true end
                end
            end
        end
        if not executed then
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if hrp then
                for _, obj in ipairs(workspace:GetDescendants()) do
                    if obj:IsA("ProximityPrompt") and (obj.ActionText:lower():find("deitar") or obj.ObjectText:lower():find("deitar") or obj.ActionText:lower():find("sleep")) then
                        if (hrp.Position - obj.Parent.Position).Magnitude <= 15 then
                            fireproximityprompt(obj) executed = true
                        end
                    end
                end
            end
        end
    end)
end

