-- ======== FÍSICA E GERENCIAMENTO DE VEÍCULO ========
local function getSeat()
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	return hum and hum.SeatPart
end

local lastSeat = nil
local function updatePhysics()
	local seat = getSeat()
	
	if seat and seat:IsA("VehicleSeat") then
		if accelOn then accelBtn.Visible = true end
		if wheelieVisible then wheelieBtn.Visible = true end
	else
		accelBtn.Visible = false
		wheelieBtn.Visible = false
	end

	if seat ~= lastSeat then
		isAccelerating = false
		isBraking = false
		currentSpeed = 0
		targetSpeed = 0
		if accelLoop then task.cancel(accelLoop); accelLoop = nil end
		if brakeLoop then task.cancel(brakeLoop); brakeLoop = nil end
		if lastSeat and lastSeat:IsA("VehicleSeat") then
			lastSeat.ThrottleFloat = 0
			lastSeat.SteerFloat = 0
		end
		lastSeat = seat
	end

	if not seat or seat.Name ~= "DriveSeat" then return end

	local chassis = seat.Parent.PrimaryPart or seat
	if not chassis then return end

	if isAccelerating or isBraking then
		seat.ThrottleFloat = isAccelerating and 1 or 0
		local targetVel = chassis.CFrame.LookVector * (targetSpeed * 1.5)
		local currentVel = chassis.AssemblyLinearVelocity
		local smoothVel = currentVel:Lerp(Vector3.new(targetVel.X, currentVel.Y, targetVel.Z), 0.2)
		chassis.AssemblyLinearVelocity = smoothVel
	else
		seat.ThrottleFloat = 0
	end
end

RunService.Heartbeat:Connect(updatePhysics)

local function startAccel()
	if brakeLoop then task.cancel(brakeLoop); brakeLoop = nil end
	isBraking = false
	if currentSpeed <= 0 then
		currentSpeed = launchIncrement
		targetSpeed = currentSpeed
	end
	isAccelerating = true
	if accelLoop then task.cancel(accelLoop) end
	accelLoop = task.spawn(function()
		while isAccelerating and not isBraking do
			currentSpeed = currentSpeed + launchIncrement
			if currentSpeed > maxSpeedLimit then
				currentSpeed = maxSpeedLimit
			end
			targetSpeed = currentSpeed
			task.wait(stepTime)
		end
	end)
end

local function startAutoBrake()
	isAccelerating = false
	if accelLoop then task.cancel(accelLoop); accelLoop = nil end
	if isBraking then return end
	isBraking = true
	if brakeLoop then task.cancel(brakeLoop) end
	brakeLoop = task.spawn(function()
		while currentSpeed > 0 do
			currentSpeed = math.max(0, currentSpeed - brakeAmount)
			targetSpeed = currentSpeed
			task.wait(brakeSpeed)
		end
		targetSpeed = 0
		currentSpeed = 0
		isBraking = false
	end)
end

