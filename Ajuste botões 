-- ============================================
-- MINIMIZAR (corrigido)
-- ============================================
local minimized = false
local savedSize = Main.Size

MinBtn.MouseButton1Click:Connect(function()
    minimized = not minimized
    if minimized then
        savedSize = Main.Size
        Main.Size = UDim2.new(0, 210, 0, 32)
        for _, obj in ipairs(hideList) do
            obj.Visible = false
        end
        MinBtn.Text = "▢"
    else
        Main.Size = savedSize
        for _, obj in ipairs(hideList) do
            obj.Visible = true
        end
        MinBtn.Text = "—"
    end
end)

-- ============================================
-- LÓGICA DE AJUSTE
-- ============================================
local adjustMode = false
local selectedButton = nil
local selectedStroke = nil

ToggleBtn.MouseButton1Click:Connect(function()
    adjustMode = not adjustMode
    if adjustMode then
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(50, 180, 80)
        ToggleBtn.Text = "ON"
    else
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        ToggleBtn.Text = "OFF"
        -- Remove destaque
        if selectedStroke then selectedStroke:Destroy() end
        selectedStroke = nil
        selectedButton = nil
    end
end)

-- ============================================
-- VERIFICA SE O OBJETO PERTENCE AO NOSSO MENU
-- ============================================
local function isInOurMenu(obj)
    local p = obj
    while p do
        if p == ScreenGui then return true end
        p = p.Parent
    end
    return false
end

-- ============================================
-- SELECIONA BOTÃO DO JOGO COM TOQUE/CLIQUE
-- ============================================
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if not adjustMode then return end
    if input.UserInputType ~= Enum.UserInputType.MouseButton1
       and input.UserInputType ~= Enum.UserInputType.Touch then return end

    local pos = input.Position
    local hits = playerGui:GetGuiObjectsAtPosition(pos.X, pos.Y)

    for _, obj in ipairs(hits) do
        if (obj:IsA("TextButton") or obj:IsA("ImageButton")
            or obj:IsA("GuiButton")) and not isInOurMenu(obj) then

            -- Remove destaque anterior
            if selectedStroke then selectedStroke:Destroy() end

            selectedButton = obj
            selectedStroke = Instance.new("UIStroke")
            selectedStroke.Color = Color3.fromRGB(255, 255, 0)
            selectedStroke.Thickness = 2.5
            selectedStroke.Name = "AjusteStroke"
            selectedStroke.Parent = obj

            InfoLabel.Text = "✅ Selecionado:\n" .. obj.Name
            return
        end
    end
end)

-- ============================================
-- AUMENTAR (+10% cada clique, mínimo +4px)
-- ============================================
IncreaseBtn.MouseButton1Click:Connect(function()
    if not adjustMode or not selectedButton then
        InfoLabel.Text = adjustMode and "⚠ Selecione um botão primeiro" or "⚠ Ative o modo ON"
        return
    end
    local s = selectedButton.Size
    local addX = math.max(4, math.floor(s.X.Offset * 0.1))
    local addY = math.max(4, math.floor(s.Y.Offset * 0.1))
    selectedButton.Size = UDim2.new(s.X.Scale, s.X.Offset + addX,
                                   s.Y.Scale, s.Y.Offset + addY)
end)

-- ============================================
-- DIMINUIR (-10% cada clique, mínimo 10px)
-- ============================================
DecreaseBtn.MouseButton1Click:Connect(function()
    if not adjustMode or not selectedButton then
        InfoLabel.Text = adjustMode and "⚠ Selecione um botão primeiro" or "⚠ Ative o modo ON"
        return
    end
    local s = selectedButton.Size
    local subX = math.max(4, math.floor(s.X.Offset * 0.1))
    local subY = math.max(4, math.floor(s.Y.Offset * 0.1))
    local newX = math.max(10, s.X.Offset - subX)
    local newY = math.max(10, s.Y.Offset - subY)
    selectedButton.Size = UDim2.new(s.X.Scale, newX, s.Y.Scale, newY)
end)

