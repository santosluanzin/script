local function SalvarConfig()
    pcall(function()
        writefile("SintoniaFarm_Config.json", HttpService:JSONEncode(Config))
    end)
end

local function CarregarConfig()
    if isfile and isfile("SintoniaFarm_Config.json") then
        local ok, data = pcall(function() return HttpService:JSONDecode(readfile("SintoniaFarm_Config.json")) end)
        if ok and data then
            if data.VelocidadeImpulso then Config.VelocidadeImpulso = data.VelocidadeImpulso end
            if data.VelocidadeVoo then Config.VelocidadeVoo = data.VelocidadeVoo end
            if data.FloatPosImpulsoX then Config.FloatPosImpulsoX = data.FloatPosImpulsoX end
            if data.FloatPosImpulsoY then Config.FloatPosImpulsoY = data.FloatPosImpulsoY end
            if data.FloatPosVooX then Config.FloatPosVooX = data.FloatPosVooX end
            if data.FloatPosVooY then Config.FloatPosVooY = data.FloatPosVooY end
        end
    end
end
