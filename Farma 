        blocoBase.Transparency = 1
        blocoBase.CanCollide = false
        blocoBase.Anchored = true
        blocoBase.Position = Vector3.new(0, -1000, 0)
    end

    if not vooLoopRunning then
        vooLoopRunning = true
        task.spawn(function()
            while isHoldingVoo do
