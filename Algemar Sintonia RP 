-- Algemar Manual
local ligado = false
local travado = false
btnToggle.MouseButton1Click:Connect(function()
    ligado = not ligado
    btnRosa.Visible = ligado
    btnToggle.Text = ligado and "ALGEMA: ON ✔️" or "ALGEMA: OFF ❌"
    btnToggle.BackgroundColor3 = ligado and Color3.fromRGB(40, 167, 69) or Color3.fromRGB(200, 50, 50)
end)
btnTrava.MouseButton1Click:Connect(function()
    travado = not travado
    btnRosa.Draggable = not travado
    btnTrava.Text = travado and "TRAVAR ALGEMA: ON 🔒" or "TRAVAR ALGEMA: OFF 🔓"
    btnTrava.BackgroundColor3 = travado and Color3.fromRGB(217, 130, 43) or Color3.fromRGB(70, 70, 70)
end)
btnRosa.MouseButton1Click:Connect(executarAlgemar)

-- AUTO ALGEMAR (Loop)
local autoAlgemarLigado = false
btnAutoAlgemar.MouseButton1Click:Connect(function()
    autoAlgemarLigado = not autoAlgemarLigado
    if autoAlgemarLigado then
        btnAutoAlgemar.Text = "AUTO ALGEMAR: ON 🔁"
        btnAutoAlgemar.BackgroundColor3 = Color3.fromRGB(0, 160, 100)
        -- Inicia o loop em segundo plano
        task.spawn(function()
            while autoAlgemarLigado do
                executarAlgemar()
                task.wait(0.15) -- Delay para não travar o celular
            end
        end)
    else
        btnAutoAlgemar.Text = "AUTO ALGEMAR: OFF ❌"
        btnAutoAlgemar.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        -- O loop vai parar sozinho na próxima checagem do "while"
    end
end)

