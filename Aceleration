	end
end)

jumpBtn.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		manualJumpRequested = false
	end
end)

RunService.RenderStepped:Connect(function()
	if not jumpVisible then return end

	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")

	if hum then
		hum.JumpPower = 50
		hum.JumpHeight = 7.2
		hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)

		local state = hum:GetState()

		if manualJumpRequested or autoJumpOn then
			if state == Enum.HumanoidStateType.Landed or
			   state == Enum.HumanoidStateType.Running or
			   state == Enum.HumanoidStateType.RunningNoPhysics then

				hum.Jump = true

				local touchGui = player.PlayerGui:FindFirstChild("TouchGui")
				if touchGui then
					local controlFrame = touchGui:FindFirstChild("TouchControlFrame")
					if controlFrame then
						local robloxJumpBtn = controlFrame:FindFirstChild("JumpButton")
						if robloxJumpBtn then
							pcall(function() robloxJumpBtn:Fire("MouseButton1Down") end)
							task.wait(0.05)
							pcall(function() robloxJumpBtn:Fire("MouseButton1Up") end)
						end
					end
				end
			end
		end
	end
end)

