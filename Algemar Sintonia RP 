-- ================== LÓGICA DO TRACER ==================
local currentTracerColor = Color3.fromRGB(savedData.tracerColorRGB[1], savedData.tracerColorRGB[2], savedData.tracerColorRGB[3])
local currentTexture = savedData.tracerShapeId

local function aplicarCorTracer(objeto)
    if not savedData.tracerLig then return end
    
    if objeto:IsA("Trail") or objeto:IsA("Beam") then
        pcall(function()
            objeto.Color = ColorSequence.new(currentTracerColor)
            objeto.LightEmission = 1
            if objeto.Texture ~= currentTexture then
                objeto.Texture = currentTexture
            end
        end)
    end
    
    if objeto:IsA("Smoke") or objeto:IsA("ParticleEmitter") then
        local nome = string.lower(objeto.Name)
        if nome:find("smoke") or nome:find("spark") or nome:find("fx") or nome:find("tiro") or nome:find("rastro") then
            pcall(function() objeto.Color = ColorSequence.new(currentTracerColor) end)
        end
    end
    
    if objeto:IsA("BasePart") then
        local nome = string.lower(objeto.Name)
        if nome:find("tracer") or nome:find("bullet") or nome:find("tiro") or nome:find("rastro") or nome:find("shot") then
            pcall(function()
                objeto.Color = currentTracerColor
                objeto.Material = Enum.Material.Neon
                -- Se o usuário escolheu uma textura, aplica na part
                if currentTexture ~= "" then
                    local tex = objeto:FindFirstChildOfClass("Texture") or Instance.new("Texture", objeto)
                    tex.Texture = currentTexture
                else
                    for _, filho in ipairs(objeto:GetChildren()) do
                        if filho:IsA("Texture") or filho:IsA("Decal") then filho:Destroy() end
                    end
                end
            end)
        end
    end
end

workspace.DescendantAdded:Connect(aplicarCorTracer)

local function atualizarTudo()
    if not savedData.tracerLig then return end
    for _, obj in ipairs(workspace:GetDescendants()) do
        aplicarCorTracer(obj)
    end
end

if savedData.tracerLig then task.spawn(atualizarTudo) end

