local function farmLoop()
    while isFarming do
        local snapBefore = snapshotAllEntregas()
        fakeSeatTP(posA)
        task.wait(1.0)
        local target = findMotoByName()
        if not target then
            local scored = diffEntregas(snapBefore)
            if #scored > 0 then target = scored[1].Obj end
        end
        if target then
            fakeSeatTP(target.Position)
            task.wait(1.0)
            fakeSeatTP(posA)
            task.wait(0.5)
        else
            task.wait(2)
        end
    end
end

farmBtn.MouseButton1Click:Connect(function()
    if not isFarming then
        if not posA then
            farmBtn.Text = "ERRO: MARQUE PONTO A!"
            task.wait(2)
            farmBtn.Text = "AUTO FARM: OFF"
            return
        end
        isFarming = true
        farmBtn.Text = "AUTO FARM: ON"
        farmBtn.BackgroundColor3 = Color3.fromRGB(70, 200, 70)
        task.spawn(farmLoop)
    else
        isFarming = false
        farmBtn.Text = "AUTO FARM: OFF"
        farmBtn.BackgroundColor3 = Color3.fromRGB(100, 100, 110)
    end
end)