            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hrp then
                local now = tick()
                for _, obj in ipairs(workspace:GetDescendants()) do
                    if obj:IsA("ProximityPrompt") and obj.Enabled then
                        local parent = obj.Parent
                        local pos = (parent:IsA("BasePart") and parent.Position) or (parent.PrimaryPart and parent.PrimaryPart.Position)
                        if pos and (pos - hrp.Position).Magnitude < (obj.MaxActivationDistance + 3) then
                            if not autoPromptCooldown[obj] or now - autoPromptCooldown[obj] > 1.0 then
                                autoPromptCooldown[obj] = now
                                if type(fireproximityprompt) == "function" then pcall(fireproximityprompt, obj) end
                            end
                        end
                    end
                end
            end
        end
        task.wait(0.2)
    end
end

