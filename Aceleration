-- ======== DETECÇÃO DE TOQUE DO BOTÃO ACELERAR (COM LIMPEZA DE TOQUES FANTASMAS) ========
local activeTouches = {}

UserInputService.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
		activeTouches[input] = input.Position
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if activeTouches[input] then
		activeTouches[input] = input.Position
	end
end)

UserInputService.InputEnded:Connect(function(input)
	activeTouches[input] = nil
end)

RunService.RenderStepped:Connect(function()
	if not accelOn then
		if isAccelerating then startAutoBrake() end
		return
	end

	local seat = getSeat()
	if not seat or not seat:IsA("VehicleSeat") then
		if isAccelerating then startAutoBrake() end
		return
	end

	local isTouching = false
	local accelPos = accelBtn.AbsolutePosition
	local accelSize = accelBtn.AbsoluteSize

	for input, pos in pairs(activeTouches) do
		-- Limpa toques travados ou inválidos automaticamente
		if input.UserInputState == Enum.UserInputState.End or input.UserInputState == Enum.UserInputState.Cancel then
			activeTouches[input] = nil
		else
			if pos.X >= accelPos.X and pos.X <= accelPos.X + accelSize.X and
			   pos.Y >= accelPos.Y and pos.Y <= accelPos.Y + accelSize.Y then
				isTouching = true
				break
			end
		end
	end

	if isTouching then
		if not isAccelerating then startAccel() end
	else
		if isAccelerating then startAutoBrake() end
	end
end)

