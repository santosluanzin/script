local function aplicarVoo()
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        local hrp = char.HumanoidRootPart
        local camLook = Camera.CFrame.LookVector
        hrp.AssemblyLinearVelocity = Vector3.new(camLook.X * Config.VelocidadeVoo, camLook.Y * Config.VelocidadeVoo, camLook.Z * Config.VelocidadeVoo)
    end
end

