local manualWheelieRequested = false

wheelieBtn.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		manualWheelieRequested = true
	end
end)

wheelieBtn.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		manualWheelieRequested = false
	end
end)

RunService.RenderStepped:Connect(function()
	if not wheelieVisible then return end
	local seat = getSeat()
	if seat and seat:IsA("VehicleSeat") then
		local chassis = seat.Parent.PrimaryPart or seat
		if chassis and manualWheelieRequested then
			local upDot = chassis.CFrame.UpVector:Dot(Vector3.new(0, 1, 0))
			if upDot > 0.4 then
				chassis.AssemblyAngularVelocity = chassis.AssemblyAngularVelocity + (chassis.CFrame.RightVector * 2.0)
			else
				chassis.AssemblyAngularVelocity = Vector3.new(0, chassis.AssemblyAngularVelocity.Y, 0)
			end
		end
	end
end)
