-- ======================== LÓGICA DO FARM ========================
local function getAllEntregas()
    local food = workspace:FindFirstChild("SintoniaFood")
    if not food then return {} end
    local locais = food:FindFirstChild("Locais")
    if not locais then return {} end
    local out = {}
    for _, obj in ipairs(locais:GetDescendants()) do
        if obj.Name == "Entrega" and obj:IsA("BasePart") then table.insert(out, obj) end
    end
    return out
end

local function snapshotAllEntregas()
    local out = {}
    for _, obj in ipairs(getAllEntregas()) do
        out[obj] = { Color = obj.Color, Material = obj.Material, Transparency = obj.Transparency, Children = {} }
        for _, d in ipairs(obj:GetDescendants()) do
            local e = { Path = d }
            if d:IsA("BillboardGui") then e.Enabled = d.Enabled
            elseif d:IsA("ProximityPrompt") then e.Enabled = d.Enabled
            elseif d:IsA("ImageLabel") or d:IsA("ImageButton") then e.Visible = d.Visible; e.Image = d.Image end
            table.insert(out[obj].Children, e)
        end
    end
    return out
end

local function diffEntregas(before)
    local scored = {}
    local afterSnapshot = snapshotAllEntregas()
    for obj, beforeSnap in pairs(before) do
        if obj and obj.Parent then
            local afterSnap = afterSnapshot[obj]
            if afterSnap then
                local score = 0
                local beforeMap = {}
                for _, e in ipairs(beforeSnap.Children) do beforeMap[e.Path] = e end
                for _, eAfter in ipairs(afterSnap.Children) do
                    local eBefore = beforeMap[eAfter.Path]
                    if eBefore then
                        if eBefore.Enabled ~= eAfter.Enabled then score = score + 50 end
                        if eBefore.Visible ~= eAfter.Visible then score = score + 50 end
                        if eBefore.Image ~= eAfter.Image then score = score + 30 end
                    else
                        score = score + 100
                    end
                end
                if score > 0 then table.insert(scored, { Obj = obj, Score = score }) end
            end
        end
    end
    table.sort(scored, function(a, b) return a.Score > b.Score end)
    return scored
end

local function findMotoByName()
    for _, obj in ipairs(getAllEntregas()) do
        local p = obj:FindFirstChild("Entregar", true)
        if p and p.Enabled then
            for _, d in ipairs(obj:GetDescendants()) do
                local n = d.Name:lower()
                if n:find("moto") or n:find("bike") or n:find("delivery") or n:find("icon") then return obj end
            end
        end
    end
    return nil
end

local function fakeSeatTP(targetPos)
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end
    hrp.CanCollide = false
    hum.PlatformStand = true 
    hum:ChangeState(Enum.HumanoidStateType.Physics)
    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero
    hrp.CFrame = CFrame.new(targetPos + Vector3.new(0, 3, 0))
    hrp.Anchored = true
    task.wait(1.5)
    if hrp and hrp.Parent then
        hrp.Anchored = false
        hrp.CanCollide = true
        hum.PlatformStand = false
        hum:ChangeState(Enum.HumanoidStateType.GettingUp)
    end
    task.wait(0.1)
end

