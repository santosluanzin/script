-- Arrastar e Minimizar
local dragging, dragStart, startPos
dragBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true; dragStart = input.Position; startPos = frame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then dragging = false end
        end)
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local d = input.Position - dragStart
        frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
    end
end)

local minimized = false
local function setMinimized(state)
    minimized = state
    if minimized then
        frame.Size = UDim2.fromOffset(150, 20)
        for _, v in pairs(frame:GetChildren()) do
            if v ~= dragBar then v.Visible = false end
        end
        minBtn.Text = "+"
    else
        frame.Size = UDim2.fromOffset(150, 154)
        for _, v in pairs(frame:GetChildren()) do
            if v ~= dragBar then v.Visible = true end
        end
        minBtn.Text = "-"
    end
end
minBtn.MouseButton1Click:Connect(function() setMinimized(not minimized) end)

-- ======================== AFUNDAR ========================
local isSunk = false
local savedCFrame = nil
local function clearBlocks()
    for _, obj in ipairs(workspace:GetChildren()) do
        if obj.Name == "SinkSupport" then obj:Destroy() end
    end
end

sinkBtn.MouseButton1Click:Connect(function()
    local character = player.Character
    if not character then return end
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    if not isSunk then
        local typed = tonumber(depthBox.Text) or 50
        typed = math.clamp(typed, 1, 5000)
        local depth = typed * 0.10

        local rayParams = RaycastParams.new()
        rayParams.FilterDescendantsInstances = {character}
        rayParams.FilterType = Enum.RaycastFilterType.Exclude
        local rayResult = workspace:Raycast(hrp.Position, Vector3.new(0, -500, 0), rayParams)

        local targetY = hrp.Position.Y - depth
        if rayResult and rayResult.Instance.CanCollide then
            local floorBottom = rayResult.Instance.Position.Y - rayResult.Instance.Size.Y / 2
            local clearBelow = floorBottom - 4
            if targetY > clearBelow then targetY = clearBelow end
        end

        local destPos = Vector3.new(hrp.Position.X, targetY, hrp.Position.Z)
        savedCFrame = hrp.CFrame
        clearBlocks()

        local block = Instance.new("Part")
        block.Name = "SinkSupport"
        block.Size = Vector3.new(200, 2, 200)
        block.Position = Vector3.new(destPos.X, targetY - 4, destPos.Z)
        block.Anchored = true
        block.CanCollide = true
        block.Material = Enum.Material.Neon
        block.Color = Color3.fromRGB(255, 100, 100)
        block.Parent = workspace

        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        hrp.CFrame = CFrame.new(destPos) * (hrp.CFrame - hrp.CFrame.Position)

        isSunk = true
        sinkBtn.Text = "VOLTAR"
        sinkBtn.BackgroundColor3 = Color3.fromRGB(70, 200, 70)
        depthBox.TextEditable = false
    else
        if savedCFrame then
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
            hrp.CFrame = savedCFrame
        end
        clearBlocks()
        isSunk = false
        savedCFrame = nil
        sinkBtn.Text = "AFUNDAR"
        sinkBtn.BackgroundColor3 = Color3.fromRGB(200, 70, 70)
        depthBox.TextEditable = true
    end
end)

-- ======================== COPIAR NICK ========================
local isCopyOn = false
local copyScanConn = nil
local copyCooldown = {}

local function copyName(name)
    if type(setclipboard) == "function" and pcall(setclipboard, name) then return true end
    if type(toclipboard) == "function" and pcall(toclipboard, name) then return true end
    return false
end

local function tryCopyPlayer(other)
    local now = tick()
    if copyCooldown[other] and now - copyCooldown[other] < 2 then return end
    copyCooldown[other] = now
    if copyName(other.Name) then
        copyBtn.Text = "✓ " .. other.Name
        notify("Nick Copiado", other.Name .. " → clipboard!", 3)
        task.delay(1.5, function() if isCopyOn then copyBtn.Text = "COPIAR NICK: ON" end end)
    end
end

local function startCopy()
    isCopyOn = true
    copyBtn.Text = "COPIAR NICK: ON"
    copyBtn.BackgroundColor3 = Color3.fromRGB(70, 200, 70)
    copyCooldown = {}
    local lastScan = 0

    copyScanConn = RunService.Heartbeat:Connect(function()
        if not isCopyOn then return end
        local now = tick()
        if now - lastScan < 0.2 then return end
        lastScan = now
        local char = player.Character
        if not char then return end
        local myHrp = char:FindFirstChild("HumanoidRootPart")
        if not myHrp then return end
        for _, other in ipairs(Players:GetPlayers()) do
            if other ~= player and other.Character then
                local otherHrp = other.Character:FindFirstChild("HumanoidRootPart")
                if otherHrp and (myHrp.Position - otherHrp.Position).Magnitude < 8 then
                    tryCopyPlayer(other)
                end
            end
        end
    end)
end

local function stopCopy()
    isCopyOn = false
    if copyScanConn then copyScanConn:Disconnect(); copyScanConn = nil end
    copyCooldown = {}
    copyBtn.Text = "COPIAR NICK: OFF"
    copyBtn.BackgroundColor3 = Color3.fromRGB(100, 100, 110)
end

copyBtn.MouseButton1Click:Connect(function()
    if isCopyOn then stopCopy() else startCopy() end
end)

-- ======================== RE (ONE-SHOT) ========================
local isReOn = false
local reTarget = nil
local reDebounce = false

local function handleReCommand(text)
    if not isReOn or type(text) ~= "string" then return end
    local clean = text:lower():match("^%s*(.-)%s*$")
    if clean ~= "/re" then return end
    if reDebounce then return end
    reDebounce = true
    task.delay(1, function() reDebounce = false end)

    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    reTarget = hrp.CFrame
    reBtn.Text = "RE: ARMADO ✓"
    reBtn.BackgroundColor3 = Color3.fromRGB(255, 200, 0)
    notify("RE Armado", "Próxima morte volta aqui.", 4)
end

player.Chatted:Connect(handleReCommand)
local TCS = game:GetService("TextChatService")
if TCS then
    TCS.MessageReceived:Connect(function(msg)
        if msg.TextSource and msg.TextSource.UserId == player.UserId then handleReCommand(msg.Text) end
    end)
end

reBtn.MouseButton1Click:Connect(function()
    if isReOn then
        isReOn = false; reTarget = nil
        reBtn.Text = "RE /re: OFF"; reBtn.BackgroundColor3 = Color3.fromRGB(100, 100, 110)
    else
        isReOn = true
        reBtn.Text = "RE /re: ON"; reBtn.BackgroundColor3 = Color3.fromRGB(70, 200, 70)
        notify("RE Ativado", "Digite /re pra marcar.", 3)
    end
end)

-- ======================== RESPAWN ========================
player.CharacterAdded:Connect(function(newChar)
    isSunk = false
    savedCFrame = nil
    clearBlocks()
    sinkBtn.Text = "AFUNDAR"
    sinkBtn.BackgroundColor3 = Color3.fromRGB(200, 70, 70)
    if depthBox then depthBox.TextEditable = true end

    if reTarget then
        local target = reTarget
        reTarget = nil
        reBtn.Text = "RE: VOLTANDO..."
        reBtn.BackgroundColor3 = Color3.fromRGB(255, 200, 0)

        task.spawn(function()
            local hrp = newChar:WaitForChild("HumanoidRootPart", 10)
            if not hrp then return end
            local startTime = tick()
            local stable = 0
            while tick() - startTime < 60 do
                if player.Character ~= newChar then return end
                local dist = (hrp.Position - target.Position).Magnitude
                if dist < 2 then
                    stable = stable + 1
                    if stable >= 20 then break end
                else
                    stable = 0
                    hrp.AssemblyLinearVelocity = Vector3.zero
                    hrp.CFrame = target
                end
                task.wait(0.03)
            end
            if isReOn then reBtn.Text = "RE /re: ON"; reBtn.BackgroundColor3 = Color3.fromRGB(70, 200, 70) end
        end)
    end

    if isCopyOn then stopCopy(); task.wait(0.5); startCopy() end
end)